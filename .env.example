# Optional. The one shared settings file for every standalone app is ~/Development/.env (mode 600); STANDALONE_ENV=/path overrides the path.
# This app reads it with util.parseEnv and takes ONLY the keys below; every other key in the file is ignored. Never put an admin or
# worker credential in it. A bare MODE is never read. This file (.env.example) is a template only; nothing loads a .env from the repo.

# Live is refused unless this is live (the owner's opt-in). mock is the default. The page opens in Mock either way.
# MFA_ADMIN_MCP_MODE=mock

# Defaults for the "PingOne standalone worker" preset (Live only). Not secrets. The worker's client id and secret are NOT read from here.
# PINGONE_ENVIRONMENT_ID=
# PINGONE_REGION=com

# Environment variables (not settings-file keys):
#   PORT=7815                  server port (7815-5249)
#   MFAADM_DATA_DIR=.data       where connections (mode 600) and the audit log live
#   MFAADM_BIND=                opt in to listen on a non-loopback address (the container sets 0.0.0.0 and is published on 127.0.0.1 only)
#   MFAADM_CONTAINER=1          set by the image only: lets Live accept the container's wide bind (a host run with MFAADM_BIND and Live is refused)
#   MFAADM_ALLOWED_HOSTS=       extra Host header names to accept
#   MFAADM_WORKER_ENV_FILE=     the local file the PingOne worker preset reads (default ~/.config/mfa-admin-mcp/worker.env, outside the repo):
#                              PINGONE_CLIENT_ID, PINGONE_CLIENT_SECRET, optionally PINGONE_ENV_ID, PINGONE_REGION, PINGONE_ENDPOINT_STYLE
#   MFAADM_BANKING_URL, MFAADM_OPENSEARCH_URL   the two local preset URLs (default http://localhost:8081/mcp and http://localhost:9900/mcp)
#   MFAADM_BANKING_TOKEN, MFAADM_BANKING_AUD    optional: a real bearer token and resource audience for the banking MCP (default: a minted local test token, aud mcp-invest.ping.demo, scope banking:read)
